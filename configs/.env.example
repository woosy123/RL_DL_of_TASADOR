# Copy this file to .env on your private experiment machine.
# Do not commit .env.

# VM SSH settings
VM_HOST=
VM_USER=
VM_SSH_PORT=22
VM_SSH_KEY=
VM_WORKLOAD_SCRIPT=~/test.sh

# Workload target
TARGET_HOST=
VM_OR_TARGET_HOST=
TARGET_PORT=
MESSAGE_SIZE=64
WORKLOAD_DURATION_SEC=30

# Host settings
NET_IFACE=
CPU_CGROUP_PATH=
CPU_CFS_PERIOD_US=100000
TRAFFIC_SHAPER_CMD=

# Experiment settings
TARGET_THROUGHPUT_MBPS=900
CPU_QUOTA_MIN=1000
CPU_QUOTA_MAX=100000
CPU_QUOTA_STEP=1000
MEASUREMENT_REPEAT=3

# Output paths
DATA_DIR=./data
RESULT_DIR=./results
